# Mia Node settings. Copy to .env; every value below is the default.

# SQLite database file for this branch node (created by `uv run mia migrate`).
MIA_DB_PATH=data/mia.db

# Model for agents. `test` runs the deterministic rules model: no API key, no network.
# Any other value is a model route on the Better Labs gateway, for example
# gateway/dispatcher-default, reached only through the egress component.
MIA_MODEL=test

# OpenAI-compatible gateway (Better Labs LiteLLM). Only used when MIA_MODEL is not `test`.
MIA_GATEWAY_URL=http://localhost:4000/v1
MIA_GATEWAY_KEY=

# Cloud egress level: `none` (nothing leaves the node) or `pseudonymised` (names replaced).
MIA_EGRESS_LEVEL=pseudonymised

# Organisation folder under node/config/org/ with organisation instructions for agents.
MIA_ORG=demo

# Geocoding provider for home bases and sites: `digitransit` (Finland, needs a key from
# https://digitransit.fi/en/developers/) or `static` (offline, no lookups).
MIA_GEOCODER=digitransit
MIA_GEOCODER_KEY=

# How often `mia serve` advances cover confirmations (message, call, next candidate); 0 = off.
MIA_TICK_SECONDS=30

# Channels (ADR 007, docs/whatsapp-setup.md). Random secret that keys link-code hashes; set it
# once and keep it (changing it invalidates open invites). Generate: python -c "import secrets; print(secrets.token_hex(32))"
MIA_NODE_SECRET=
# Public HTTPS address of this node (the Cloudflare Tunnel hostname), used in links Mia sends.
MIA_PUBLIC_URL=http://localhost:8000

# WhatsApp Business Platform (Meta Cloud API). Token and app secret are secrets: .env only.
MIA_WA_TOKEN=
MIA_WA_APP_SECRET=
# Any string you choose; enter the same value in Meta's webhook settings.
MIA_WA_VERIFY_TOKEN=
MIA_WA_PHONE_NUMBER_ID=
# Mia's WhatsApp number in international format, digits only (for wa.me invite links).
MIA_WA_NUMBER=
MIA_WA_GRAPH_URL=https://graph.facebook.com/v21.0

# Docker Compose install only (deploy/install.md). The local dev server ignores these.
# Image to run; `docker compose build` makes mia-node:local from this repository.
MIA_IMAGE=mia-node:local
# Host port, bound to 127.0.0.1 only.
MIA_PORT=8000
# Litestream backup target (ADR 010). Backups hold real business data: use a private bucket with
# encryption at rest. file:///backups/mia is a local volume for testing only; for real use e.g.
# s3://<bucket>/<branch>/mia, plus the endpoint for non-AWS storage (Backblaze, Hetzner, MinIO).
LITESTREAM_REPLICA_URL=file:///backups/mia
LITESTREAM_S3_ENDPOINT=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
# Cloudflare Tunnel token, for `docker compose --profile tunnel up -d` (docs/whatsapp-setup.md).
CLOUDFLARE_TUNNEL_TOKEN=
